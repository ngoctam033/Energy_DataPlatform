{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:energy-lab:scenario:1",
  "title": "Simulation scenario (runtime cross-reference checks in engine.cjs)",
  "type": "object",
  "required": ["schema_version", "id", "name", "enabled", "kind", "schedule", "parameters"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "name": {"type": "string"},
    "enabled": {"type": "boolean"},
    "kind": {"enum": ["charging_demand", "power_profile", "native_dispatch"]},
    "schedule": {
      "type": "object", "additionalProperties": false,
      "required": ["timezone", "type", "times", "catch_up_seconds"],
      "properties": {
        "timezone": {"const": "Asia/Ho_Chi_Minh"}, "type": {"const": "daily"},
        "times": {"type": "array", "minItems": 1, "maxItems": 1440, "uniqueItems": true, "items": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}},
        "catch_up_seconds": {"type": "integer", "minimum": 0, "maximum": 3600}
      }
    },
    "parameters": {"type": "object"}
  },
  "$defs": {
    "weights": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}},
    "duration": {"type": "object", "required": ["min", "max"], "additionalProperties": false, "properties": {"min": {"type": "integer", "minimum": 30, "maximum": 10800}, "max": {"type": "integer", "minimum": 30, "maximum": 10800}}}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "charging_demand"}}}, "then": {"properties": {"parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["vehicle_count_by_time", "duration_by_time", "arrival_window_seconds", "arrival_distribution", "seed", "target_pool", "max_parallel", "max_wait_seconds", "queue_policy", "on_full", "behaviors", "site_weights", "charging_type_weights"],
      "properties": {
        "vehicle_count_by_time": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 1000}},
        "duration_by_time": {"type": "object", "additionalProperties": {"$ref": "#/$defs/duration"}},
        "arrival_window_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "arrival_distribution": {"enum": ["uniform", "even"]},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "target_pool": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "max_parallel": {"type": "integer", "minimum": 1, "maximum": 200},
        "max_wait_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "queue_policy": {"const": "fifo"}, "on_full": {"enum": ["queue", "reject"]},
        "behaviors": {"$ref": "#/$defs/weights"}, "site_weights": {"$ref": "#/$defs/weights"}, "charging_type_weights": {"$ref": "#/$defs/weights"},
        "customer_profiles": {"type":"object"}, "customer_weights_by_time": {"type":"object"}
      }
    }}}},
    {"if": {"properties": {"kind": {"const": "power_profile"}}}, "then": {"properties": {"parameters": {
      "type": "object", "additionalProperties": false, "required": ["target", "profile_w"],
      "properties": {"target": {"type": "string"}, "profile_w": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 200000}}}
    }}}},
    {"if": {"properties": {"kind": {"const": "native_dispatch"}}}, "then": {"properties": {"parameters": {
      "type": "object", "required": ["actions"], "additionalProperties": false,
      "properties": {"actions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
        "type": "object", "required": ["id", "target", "command", "transport", "payload", "offset_seconds"], "additionalProperties": false,
        "properties": {"id": {"type": "string"}, "target": {"type": "string"}, "command": {"enum": ["execute_charging_session", "set_power_w"]}, "transport": {"enum": ["mqtt", "http"]}, "payload": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["value"], "properties": {"value": {"type": "integer"}}}]}, "offset_seconds": {"type": "integer", "minimum": 0, "maximum": 86400}}
      }}}
    }}}}
  ]
}
